{
  "slug": "pi-web",
  "name": "Pi Web",
  "identifier": "com.lizhian.piweb",
  "url": "http://127.0.0.1:30141",
  "port": "30141",
  "command": "pi-web --hostname 127.0.0.1 --port 30141 --no-open",
  "macIcon": "build/pi-web/assets/pi_web.icns",
  "desktopIcon": "build/pi-web/assets/pi_web.png",
  "commonArgs": [
    "--allow-open-path",
    "--new-window",
    "--enable-drag-drop",
    "--enable-find",
    "--safe-domain",
    "127.0.0.1:30141",
    "--wasm"
  ],
  "platformArgs": {
    "macos": [
      "--traffic-light-x",
      "11",
      "--traffic-light-y",
      "16",
      "--drag-region-height",
      "10",
      "--camera",
      "--microphone",
      "--inject",
      "build/pi-web/scripts/pi-web-inject.css,build/pi-web/scripts/pi-web-inject.js"
    ]
  }
}
